{
  "version": 2,
  "builds": [
    {
      "src": "api/contact.js",
      "use": "@vercel/node"
    },
    {
      "src": "portfolio/ui-themez.smartinnovates.net/items/zain/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/contact.js"
    },
    {
      "src": "/(.*)",
      "dest": "/portfolio/ui-themez.smartinnovates.net/items/zain/$1"
    }
  ]
}